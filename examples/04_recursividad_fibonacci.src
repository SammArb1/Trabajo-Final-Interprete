let fib = function(n) {
    if (n < 2) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

let factorial = function(n) {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

print("fib(10) =", fib(10))
print("fib(15) =", fib(15))
print("5! =", factorial(5))
print("10! =", factorial(10))

let sumar = function(a, b) {
    let resultado = a + b
    return resultado
}
print("sumar(3, 4) =", sumar(3, 4))

let crear_contador = function() {
    let c = 0
    return function() {
        c = c + 1
        return c
    }
}
let cont = crear_contador()
cont()
cont()
print("contador tras 3 llamadas =", cont())
