let i = 1
let suma = 0
while (i <= 5) {
    suma = suma + i
    i = i + 1
}
print("suma 1..5 =", suma)

let n = 0
while (true) {
    if (n == 4) {
        break
    }
    n = n + 1
}
print("n al romper =", n)

let total = 0
for (let k = 1; k <= 4; k = k + 1) {
    total = total + k * k
}
print("suma de cuadrados 1..4 =", total)

let hallado = 0
for (let j = 22; j < 100; j = j + 1) {
    if (j / 7 == int(j / 7)) {
        hallado = j
        break
    }
}
print("primer multiplo de 7 > 21:", hallado)
