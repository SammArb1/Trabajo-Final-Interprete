let a = 10
let b = 3
print("a + b =", a + b)
print("a - b =", a - b)
print("a * b =", a * b)
print("a / b =", a / b)

print("2 + 3 * 4 =", 2 + 3 * 4)
print("(2 + 3) * 4 =", (2 + 3) * 4)

print("2 ** 3 ** 2 =", 2 ** 3 ** 2)

print("10 - 4 - 3 =", 10 - 4 - 3)

let x = 5
x = x + 1
x = x * 2
print("x =", x)

let pi = 3.14
print("pi * 2 =", pi * 2)
print("tipo de 1 + 0.5:", type(1 + 0.5))

let nombre = "Mundo"
print("Hola, " + nombre + "!")
